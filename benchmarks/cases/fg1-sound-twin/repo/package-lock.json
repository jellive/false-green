{
  "name": "shopfront",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "shopfront",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@shopfront/api",
      "version": "1.0.0",
      "dependencies": {
        "@shopfront/money": "1.0.0"
      }
    },
    "apps/mobile": {
      "name": "@shopfront/mobile",
      "version": "1.0.0",
      "dependencies": {
        "@shopfront/money": "1.0.0"
      }
    },
    "apps/web": {
      "name": "@shopfront/web",
      "version": "1.0.0",
      "dependencies": {
        "@shopfront/money": "1.0.0"
      }
    },
    "node_modules/@shopfront/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@shopfront/mobile": {
      "resolved": "apps/mobile",
      "link": true
    },
    "node_modules/@shopfront/money": {
      "resolved": "packages/money",
      "link": true
    },
    "node_modules/@shopfront/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/money": {
      "name": "@shopfront/money",
      "version": "1.0.0"
    }
  }
}
