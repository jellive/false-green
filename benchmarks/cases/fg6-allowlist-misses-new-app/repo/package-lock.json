{
  "name": "duedate",
  "version": "4.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "duedate",
      "version": "4.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ]
    },
    "apps/reminder": {
      "name": "@due/reminder",
      "version": "0.3.0",
      "dependencies": {
        "@due/timefmt": "1.0.3"
      }
    },
    "node_modules/@due/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@due/reminder": {
      "resolved": "apps/reminder",
      "link": true
    },
    "node_modules/@due/timefmt": {
      "resolved": "packages/timefmt",
      "link": true
    },
    "packages/core": {
      "name": "@due/core",
      "version": "2.0.0"
    },
    "packages/timefmt": {
      "name": "@due/timefmt",
      "version": "1.0.3"
    }
  }
}
